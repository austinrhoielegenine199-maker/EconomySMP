# Reference only. Do not install this as a second plugin.yml in EconomySMP.
# EconomySMP remains the only plugin entrypoint; merge commands/permissions into its plugin.yml when integrating Flakes.
name: Flakes
version: '1.0'
main: com.archiveaustxn.flakes.FlakesPlugin
api-version: '1.21'
author: EconomySMP
description: Flakes currency module
softdepend: [PlaceholderAPI]
folia-supported: true

permissions:
  flakes.admin:
    default: op
  flakes.use:
    default: true
  flakes.vip:
    default: false
  flakes.bal:
    default: op
  flakes.pay:
    default: true
